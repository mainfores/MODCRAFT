<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Minecraft Mods · Showcase</title>

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      background-image: url('file:///C:/Users/NITRO%20PC/Desktop/Моды/5749411.jpg');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      background-repeat: no-repeat;
      padding: 2rem 1.5rem;
      color: #e8edf5;
      position: relative;
    }

    /* затемнение */
    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(10, 14, 18, 0.7);
      backdrop-filter: blur(2px);
      -webkit-backdrop-filter: blur(2px);
      z-index: 0;
    }

    .container {
      max-width: 1340px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    /* ===== HEADER ===== */
    .header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
      margin-bottom: 3rem;
      padding: 1.2rem 2rem;
      background: rgba(13, 18, 23, 0.75);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-radius: 20px;
      border: 1px solid rgba(255, 255, 255, 0.06);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      font-family: 'Press Start 2P', monospace;
      font-size: 1.4rem;
      color: #8fdc8f;
      text-shadow: 0 0 30px rgba(100, 200, 100, 0.2);
    }

    .logo i {
      font-size: 1.8rem;
      color: #7cb87c;
    }

    .logo span {
      background: linear-gradient(135deg, #8fdc8f, #5a9e5a);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 1.2rem;
      font-size: 0.75rem;
      font-weight: 500;
      color: #a0c8a0;
    }

    .header-right i {
      color: #8fdc8f;
    }

    .header-right .count {
      background: rgba(100, 200, 100, 0.1);
      padding: 0.2rem 1rem;
      border-radius: 30px;
      color: #8fdc8f;
      border: 1px solid rgba(100, 180, 100, 0.1);
    }

    /* ===== GRID ===== */
    .mod-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
      gap: 2rem;
    }

    /* ===== CARD — только свечение, без движения ===== */
    .mod-card {
      background: rgba(16, 22, 28, 0.8);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-radius: 20px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.06);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      display: flex;
      flex-direction: column;
      transition: box-shadow 0.4s ease, border-color 0.4s ease;
    }

    /* свечение при наведении — без движения */
    .mod-card:hover {
      border-color: rgba(100, 200, 100, 0.25);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3), 0 0 30px rgba(100, 200, 100, 0.06), 0 0 60px rgba(100, 200, 100, 0.03);
    }

    /* preview */
    .preview {
      width: 100%;
      height: 190px;
      background: #0a0e12;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      flex-shrink: 0;
      position: relative;
    }

    .preview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }

    .mod-card:hover .preview img {
      transform: scale(1.03);
    }

    .preview .fallback {
      font-size: 3rem;
      color: #3a5a3a;
    }

    /* card body */
    .card-body {
      padding: 1.2rem 1.4rem 1.4rem;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .title-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 0.2rem;
    }

    .title-row h3 {
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: #f0f7f0;
    }

    .title-row h3 i {
      color: #8fdc8f;
      font-size: 0.85rem;
      margin-right: 0.3rem;
    }

    .version-tag {
      background: rgba(100, 200, 100, 0.1);
      padding: 0.15rem 0.8rem;
      border-radius: 40px;
      font-size: 0.55rem;
      font-weight: 600;
      color: #8fdc8f;
      border: 1px solid rgba(100, 180, 100, 0.1);
      font-family: 'Press Start 2P', monospace;
      white-space: nowrap;
    }

    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem 1rem;
      font-size: 0.65rem;
      color: #8aa88a;
      margin: 0.4rem 0 0.5rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .meta i {
      color: #8fdc8f;
      width: 1rem;
      font-size: 0.65rem;
    }

    .meta .badge-type {
      background: rgba(100, 200, 100, 0.05);
      padding: 0.1rem 0.7rem;
      border-radius: 20px;
      font-size: 0.5rem;
      border: 1px solid rgba(100, 180, 100, 0.05);
    }

    .description {
      font-size: 0.82rem;
      line-height: 1.6;
      color: #c8d8c8;
      margin: 0.2rem 0 0.8rem;
      flex: 1;
    }

    .description .hint {
      display: block;
      font-size: 0.6rem;
      color: #6a8a6a;
      margin-top: 0.3rem;
    }

    .description .hint i {
      color: #8fdc8f;
      margin-right: 0.3rem;
    }

    .file-badge {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      background: rgba(0, 0, 0, 0.25);
      padding: 0.35rem 1rem;
      border-radius: 40px;
      border: 1px solid rgba(255, 255, 255, 0.04);
      font-size: 0.6rem;
      font-weight: 500;
      color: #a0c0a0;
      margin-bottom: 0.8rem;
    }

    .file-badge i {
      color: #8fdc8f;
    }

    .file-badge .size {
      margin-left: auto;
      background: rgba(100, 200, 100, 0.06);
      padding: 0.1rem 0.6rem;
      border-radius: 20px;
      color: #8fdc8f;
      font-size: 0.55rem;
      border: 1px solid rgba(100, 180, 100, 0.04);
    }

    .file-badge span:not(.size) {
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 130px;
      white-space: nowrap;
    }

    /* ===== АНИМИРОВАННАЯ КНОПКА ===== */
    .download-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.7rem;
      padding: 0.55rem 1.2rem;
      background: linear-gradient(135deg, #1a3a1a, #2d5a2d);
      border: 1px solid rgba(100, 200, 100, 0.15);
      color: #8fdc8f;
      font-family: 'Inter', sans-serif;
      font-size: 0.65rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 60px;
      cursor: pointer;
      width: 100%;
      justify-content: center;
      letter-spacing: 0.3px;
      text-transform: uppercase;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    /* анимация пульсации */
    .download-btn::before {
      content: '';
      position: absolute;
      top: -2px;
      left: -2px;
      right: -2px;
      bottom: -2px;
      background: linear-gradient(135deg, #2d5a2d, #5a9e5a, #2d5a2d, #1a3a1a);
      background-size: 300% 300%;
      border-radius: 62px;
      z-index: -1;
      opacity: 0;
      transition: opacity 0.4s ease;
      animation: gradientMove 3s ease-in-out infinite;
    }

    .download-btn:hover::before {
      opacity: 1;
    }

    .download-btn::after {
      content: '';
      position: absolute;
      inset: 2px;
      background: linear-gradient(135deg, #1a3a1a, #2d5a2d);
      border-radius: 58px;
      z-index: -1;
      transition: background 0.3s ease;
    }

    .download-btn:hover::after {
      background: linear-gradient(135deg, #2d5a2d, #3d7a3d);
    }

    .download-btn:hover {
      color: #a0eca0;
      border-color: rgba(100, 200, 100, 0.3);
      transform: scale(1.02);
      box-shadow: 0 0 30px rgba(100, 200, 100, 0.15), 0 0 60px rgba(100, 200, 100, 0.05);
    }

    .download-btn:active {
      transform: scale(0.97);
    }

    .download-btn i {
      font-size: 0.8rem;
      color: #8fdc8f;
      transition: transform 0.3s ease;
    }

    .download-btn:hover i {
      transform: translateY(-1px) scale(1.1);
    }

    .download-btn .file-type {
      background: rgba(0, 0, 0, 0.2);
      padding: 0.1rem 0.6rem;
      border-radius: 20px;
      font-size: 0.45rem;
      font-weight: 700;
      border: 1px solid rgba(100, 180, 100, 0.06);
      transition: background 0.3s ease;
    }

    .download-btn:hover .file-type {
      background: rgba(0, 0, 0, 0.3);
    }

    /* анимация градиента для обводки */
    @keyframes gradientMove {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    /* дополнительная пульсация для кнопки */
    .download-btn {
      animation: subtlePulse 2s ease-in-out infinite;
    }

    @keyframes subtlePulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(100, 200, 100, 0); }
      50% { box-shadow: 0 0 15px rgba(100, 200, 100, 0.04); }
    }

    .download-btn:hover {
      animation: none;
      box-shadow: 0 0 30px rgba(100, 200, 100, 0.15), 0 0 60px rgba(100, 200, 100, 0.05);
    }

    /* ===== FOOTER ===== */
    .footer {
      margin-top: 3rem;
      padding: 1.2rem 2rem;
      background: rgba(13, 18, 23, 0.6);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-radius: 16px;
      border: 1px solid rgba(255, 255, 255, 0.04);
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      font-size: 0.65rem;
      color: #6a8a6a;
    }

    .footer .badge-group {
      display: flex;
      gap: 1.2rem;
      flex-wrap: wrap;
    }

    .footer .badge-group span {
      background: rgba(100, 180, 100, 0.04);
      padding: 0.2rem 1rem;
      border-radius: 40px;
      border: 1px solid rgba(100, 180, 100, 0.04);
    }

    .footer i {
      color: #8fdc8f;
      margin-right: 0.3rem;
    }

    .footer .highlight {
      color: #8fdc8f;
      font-weight: 500;
    }

    .image-hint {
      margin-top: 1rem;
      font-size: 0.5rem;
      color: #4a6a4a;
      text-align: center;
      padding: 0.8rem;
      background: rgba(0, 0, 0, 0.2);
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.02);
    }

    .image-hint i {
      color: #6a8a6a;
      margin-right: 0.2rem;
    }

    .image-hint span {
      color: #7a9a7a;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 640px) {
      body {
        padding: 1rem;
      }
      .header {
        flex-direction: column;
        align-items: stretch;
        padding: 1rem 1.2rem;
        gap: 0.8rem;
      }
      .logo {
        font-size: 1.1rem;
        justify-content: center;
      }
      .header-right {
        justify-content: center;
        font-size: 0.65rem;
        flex-wrap: wrap;
      }
      .mod-grid {
        grid-template-columns: 1fr;
      }
      .preview {
        height: 160px;
      }
      .footer {
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
      .footer .badge-group {
        justify-content: center;
      }
    }
  </style>
</head>
<body>

