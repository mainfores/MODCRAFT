          alt="Damn Difficult Progression"
          onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\'fallback\'><i class=\'fa-dungeon\'></i></div>'" />
        </div>
        <div class="card-body">
          <div class="title-row">
            <h3><i class="fas fa-dungeon" style="color:#8fdc8f"></i> Damn Difficult Progression</h3>
            <span class="version-tag">1.12.2</span>
          </div>
          <div class="meta">
